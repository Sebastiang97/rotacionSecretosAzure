          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="XYxY_0fvi3l5-d3zep0_-7" value="Event Grid System Topic&lt;div&gt;(&lt;span style=&quot;background-color: initial;&quot;&gt;Event&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;Subscription)&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;sketch=0;strokeWidth=2;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="2040" y="80" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="XYxY_0fvi3l5-d3zep0_-15" value="Event" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;curved=0;" edge="1" parent="1" source="XYxY_0fvi3l5-d3zep0_-16" target="XYxY_0fvi3l5-d3zep0_-7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="XYxY_0fvi3l5-d3zep0_-16" value="Event Grid System Topic" style="rounded=0;whiteSpace=wrap;html=1;sketch=0;strokeWidth=2;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1830" y="80" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="SrXrHbBEt5PRq0NriGRR-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="XYxY_0fvi3l5-d3zep0_-19" target="XYxY_0fvi3l5-d3zep0_-3">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="2100" y="350" />
              <mxPoint x="1365" y="350" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="SrXrHbBEt5PRq0NriGRR-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="XYxY_0fvi3l5-d3zep0_-19" target="XYxY_0fvi3l5-d3zep0_-5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="XYxY_0fvi3l5-d3zep0_-19" value="Function&lt;div&gt;(StorageAccoun&lt;/div&gt;&lt;div&gt;AccessKeyRotation)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;sketch=0;strokeWidth=2;fillColor=#dae8fc;strokeColor=#6c8ebf;horizontal=1;align=center;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="2040" y="260" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="XYxY_0fvi3l5-d3zep0_-24" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;text-align: left; background-color: initial;&quot;&gt;En un paso inicial, se crea el Storage Account y se guarda en un secreto en el Key Vault el valor de la llave de acceso primaria.&lt;/span&gt;&lt;br&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;sketch=1;curveFitting=1;jiggle=2;dashed=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="1265" y="-40" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="u2kfY7iSUENpfg3OF0mU-6" value="&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;El último valor del secreto en el Key Vault será el valor útil, el que se debería usar por los sistemas que requieran de la llave de acceso del Storage Account.&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;El secreto almacenado tendrá los siguientes tags para la operación:&lt;/span&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;CredentialId: ayuda a identificar la llave almacenada posibles valores, rota entre key1 o key2&lt;br&gt;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;ProviderAddress: corresponde al id del Storage Account&lt;br&gt;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;ValidityPeriodDays: indica la cantidad de días que será válido el secreto. Ayuda a extablecer el tiempo de expiración de la llave rotada.&lt;br&gt;&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;div&gt;Adicionalmente se debe establecer una fecha de expiración al secreto&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;sketch=1;curveFitting=1;jiggle=2;dashed=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="1540" y="-340" width="200" height="390" as="geometry" />
        </mxCell>
        <mxCell id="kRoo-2Par4iTLeIj-TzA-2" value="&lt;div style=&quot;&quot;&gt;Se crea un Event System Topic el cual está diseñado para recibir notificación de eventos de recursos de Azure. Cuando se crea se establece el recurso origen de dichos eventos.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;sketch=1;curveFitting=1;jiggle=2;dashed=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="1790" y="-70" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="kRoo-2Par4iTLeIj-TzA-3" value="&lt;div style=&quot;&quot;&gt;Se crea una suscripción a un evento del Key Vault de tipo&amp;nbsp;SecretNearExpiry. Esto genera un evento cuando el secreto está a 30 días de expirar.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;sketch=1;curveFitting=1;jiggle=2;dashed=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="2000" y="-70" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="XYxY_0fvi3l5-d3zep0_-27" value="&lt;div&gt;La función es creada para con un trigger de tipo event grid&lt;/div&gt;&lt;ul&gt;&lt;li style=&quot;border-color: var(--border-color);&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;Con los datos del evento se obtiene información del secreto en el Key Vault que generó el evento de&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;text-align: center;&quot;&gt;SecretNearExpiry&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;border-color: var(--border-color);&quot;&gt;Entre los datos requeridos se obtiene los valores de los tags asociados al secreto&lt;/li&gt;&lt;ul&gt;&lt;li style=&quot;border-color: var(--border-color);&quot;&gt;CredentialId&lt;br&gt;&lt;/li&gt;&lt;li style=&quot;border-color: var(--border-color);&quot;&gt;ProviderAddress&lt;br&gt;&lt;/li&gt;&lt;li style=&quot;border-color: var(--border-color);&quot;&gt;ValidityPeriodDays&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;&lt;li style=&quot;border-color: var(--border-color);&quot;&gt;Basado en el actual valor de CredentialId, se rota al siguiente, el cual está entre key1 o key2. Esto ayuda a identificar la llave que será rotada y almacenada en el secreto del Kay vault.&lt;/li&gt;&lt;li style=&quot;border-color: var(--border-color);&quot;&gt;Con los datos de ProviderAddress y el nuevo CredentialId se rota la llave del Storage Account.&amp;nbsp;&lt;/li&gt;&lt;ul&gt;&lt;li style=&quot;border-color: var(--border-color);&quot;&gt;Ejemplo: si CredentialId era key1, el valor nuevo es key2, por tanto esa es la llave de acceso que se rotará en el Storage Account.&lt;/li&gt;&lt;/ul&gt;&lt;li style=&quot;border-color: var(--border-color);&quot;&gt;Por último se crea un nuevo valor en el secreto del Key Vault el cual corresponde a la llave de acceso rotada en el proceso anterior, se asignan los tags con los nuevos valores, además de establecer la nueva fecha de expiración del secreto que corresponde al valor de ValidityPeriodDays sumado a la fecha actual.&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;sketch=1;curveFitting=1;jiggle=2;dashed=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="2170" y="180" width="500" height="326" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
