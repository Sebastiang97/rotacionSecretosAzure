  <diagram id="_vekXoXHab5yewwAdB7L" name="Rotación de llaves de acceso ST - Flujo de datos">
    <mxGraphModel dx="1434" dy="844" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="zF2rWbynfQ4SQ-kUngxf-1" value="&lt;div style=&quot;&quot;&gt;Datos iniciales&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;ul&gt;&lt;li&gt;Nombre de secreto: access-key-st&lt;/li&gt;&lt;li&gt;tags:&amp;nbsp;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;CredentialId: key1&lt;/li&gt;&lt;li&gt;ProviderAddress: storage account id&lt;/li&gt;&lt;li&gt;ValidityPeriodDays: 75&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;Storage Account&lt;/li&gt;&lt;ul&gt;&lt;li&gt;key1: última rotación: 0 días&lt;/li&gt;&lt;li&gt;key2: última rotación: 0 días&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;/div&gt;&lt;div&gt;Acciones:&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;Creación inicial del secreto en el Key Vault&lt;/li&gt;&lt;/ul&gt;&lt;div&gt;Datos finales:&lt;br&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;Nombre de secreto: access-key-st&lt;/li&gt;&lt;li&gt;tags:&amp;nbsp;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;CredentialId: key1&lt;/li&gt;&lt;li&gt;ProviderAddress: storage account id&lt;/li&gt;&lt;li&gt;ValidityPeriodDays: 75&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;Storage Account&lt;/li&gt;&lt;ul&gt;&lt;li&gt;key1: última rotación: 0 días&lt;/li&gt;&lt;li&gt;key2: última rotación: 0 días&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;sketch=1;curveFitting=1;jiggle=2;dashed=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="250" height="510" as="geometry" />
        </mxCell>
        <mxCell id="PLib5eQC6KbIeMbSQFXk-1" value="&lt;div style=&quot;&quot;&gt;Datos iniciales&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;ul&gt;&lt;li&gt;Nombre de secreto: access-key-st&lt;/li&gt;&lt;li&gt;tags secreto:&amp;nbsp;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;CredentialId: key1&lt;/li&gt;&lt;li&gt;ProviderAddress: storage account id&lt;/li&gt;&lt;li&gt;ValidityPeriodDays: 75&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;Storage Account&lt;/li&gt;&lt;ul&gt;&lt;li&gt;key1: última rotación: 45 días&lt;/li&gt;&lt;li&gt;key2: última rotación: 45 días&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;/div&gt;&lt;div&gt;Acciones:&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;30 días antes del vencimiento del secreto, es decir a los 45 días de creado el secreto, se genera el evento de&amp;nbsp;&lt;span style=&quot;text-align: center;&quot;&gt;SecretNearExpiry&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;text-align: center;&quot;&gt;Se ejecuta el proceso de rotación de llaves&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;div&gt;Datos finales:&lt;br&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;Nombre de secreto: access-key-st&lt;/li&gt;&lt;li&gt;tags secreto:&amp;nbsp;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;CredentialId: key2&lt;/li&gt;&lt;li&gt;ProviderAddress: storage account id&lt;/li&gt;&lt;li&gt;ValidityPeriodDays: 75&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;Storage Account&lt;/li&gt;&lt;ul&gt;&lt;li&gt;key1: última rotación: 45 días&lt;/li&gt;&lt;li&gt;key2: última rotación: 0 días&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;sketch=1;curveFitting=1;jiggle=2;dashed=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="330" y="20" width="250" height="510" as="geometry" />
        </mxCell>
        <mxCell id="QroEDM-Uj-i0I-1douGu-1" value="&lt;div style=&quot;&quot;&gt;Datos iniciales&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;ul&gt;&lt;li&gt;Nombre de secreto: access-key-st&lt;/li&gt;&lt;li&gt;tags secreto:&amp;nbsp;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;CredentialId: key2&lt;/li&gt;&lt;li&gt;ProviderAddress: storage account id&lt;/li&gt;&lt;li&gt;ValidityPeriodDays: 75&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;Storage Account&lt;/li&gt;&lt;ul&gt;&lt;li&gt;key1: última rotación: 90 días&lt;/li&gt;&lt;li&gt;key2: última rotación: 45 días&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;/div&gt;&lt;div&gt;Acciones:&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;Nuevamente a los 30 días antes del vencimiento del secreto, es decir a los 45 días de la última rotación, se genera el evento de&amp;nbsp;&lt;span style=&quot;text-align: center;&quot;&gt;SecretNearExpiry&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;text-align: center;&quot;&gt;Se ejecuta el proceso de rotación de llaves&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;div&gt;Datos finales:&lt;br&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;Nombre de secreto: access-key-st&lt;/li&gt;&lt;li&gt;tags secreto:&amp;nbsp;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;CredentialId: key1&lt;/li&gt;&lt;li&gt;ProviderAddress: storage account id&lt;/li&gt;&lt;li&gt;ValidityPeriodDays: 75&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;Storage Account&lt;/li&gt;&lt;ul&gt;&lt;li&gt;key1: última rotación: 0 días&lt;/li&gt;&lt;li&gt;key2: última rotación: 45 días&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;sketch=1;curveFitting=1;jiggle=2;dashed=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="620" y="20" width="250" height="510" as="geometry" />
        </mxCell>
        <mxCell id="w_-O6dFFJTNv2ZdYyeXr-1" value="&lt;div style=&quot;&quot;&gt;Importante:&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;ul&gt;&lt;li&gt;El valor del secreto en el Key Vault rotará cada ValidityPeriodDays - 30 días&lt;/li&gt;&lt;li&gt;Cada llave de acceso del ST será rotada como máximo cada (ValidityPeriodDays - 30)*2 días&lt;/li&gt;&lt;li&gt;El valor útil de la llave de acceso del ST será la almacenada en el secreto del Kay Vault&lt;/li&gt;&lt;li&gt;La fecha de expiración del secreto en el Key Vault servirá sólo para iniciar el proceso de rotación, mas no invalidará ninguna de las llaves de acceso del ST.&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;El proceso será transparente para los servicios Azure que obtengan el valor de la llave de acceso desde el secreto del Key Vault&lt;/span&gt;&lt;br&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;Para los servicios externos, a los cuales se le comparte la llave de acceso de forma &quot;manual&quot;, se debe enviar la nueva llave de acceso útil.&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;sketch=1;curveFitting=1;jiggle=2;dashed=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="580" width="600" height="190" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
