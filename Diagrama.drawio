        <mxCell id="kExKvFFj_C3QVHxMIAXy-32" value="4.2" style="whiteSpace=wrap;html=1;fillColor=#1ba1e2;fontColor=#ffffff;strokeColor=#006EAF;glass=0;rounded=1;" parent="kExKvFFj_C3QVHxMIAXy-1" vertex="1">
          <mxGeometry x="300" y="180" width="20" height="20" as="geometry" />
        </mxCell>
        <mxCell id="kExKvFFj_C3QVHxMIAXy-33" value="4" style="whiteSpace=wrap;html=1;fillColor=#1ba1e2;fontColor=#ffffff;strokeColor=#006EAF;glass=0;rounded=1;" parent="kExKvFFj_C3QVHxMIAXy-1" vertex="1">
          <mxGeometry x="960" y="332" width="20" height="20" as="geometry" />
        </mxCell>
        <mxCell id="kExKvFFj_C3QVHxMIAXy-34" value="2" style="whiteSpace=wrap;html=1;fillColor=#1ba1e2;fontColor=#ffffff;strokeColor=#006EAF;glass=0;rounded=1;" parent="kExKvFFj_C3QVHxMIAXy-1" vertex="1">
          <mxGeometry x="37" y="579" width="20" height="20" as="geometry" />
        </mxCell>
        <mxCell id="kExKvFFj_C3QVHxMIAXy-35" value="4" style="whiteSpace=wrap;html=1;fillColor=#1ba1e2;fontColor=#ffffff;strokeColor=#006EAF;glass=0;rounded=1;" parent="kExKvFFj_C3QVHxMIAXy-1" vertex="1">
          <mxGeometry x="37" y="664" width="20" height="20" as="geometry" />
        </mxCell>
        <mxCell id="kExKvFFj_C3QVHxMIAXy-36" value="&lt;span style=&quot;text-wrap: nowrap;&quot;&gt;Inicialmente se almacena en un secreto del key vault la llave primaria de acceso del&amp;nbsp;&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;text-wrap: nowrap;&quot;&gt;storage account con una fecha de expiración de 75 días. Cada llave rota cada 90 días&lt;/span&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;" parent="kExKvFFj_C3QVHxMIAXy-1" vertex="1">
          <mxGeometry x="67" y="534" width="490" height="30" as="geometry" />
        </mxCell>
        <mxCell id="kExKvFFj_C3QVHxMIAXy-37" value="&lt;span style=&quot;text-align: center; text-wrap: nowrap; background-color: rgb(255, 255, 255);&quot;&gt;El EventGrid System Topic&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;text-align: center; text-wrap: nowrap; background-color: initial;&quot;&gt;Event Subscription enruta el evento hacia el una función que&amp;nbsp;&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;text-align: center; text-wrap: nowrap; background-color: initial;&quot;&gt;se encarga de ejecutar el proceso de rotación de llaves de acceso&lt;/span&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;" parent="kExKvFFj_C3QVHxMIAXy-1" vertex="1">
          <mxGeometry x="67" y="619" width="490" height="30" as="geometry" />
        </mxCell>
        <mxCell id="kExKvFFj_C3QVHxMIAXy-38" value="&lt;span style=&quot;text-wrap: nowrap;&quot;&gt;Cuando el secreto esté cerca a expirar (30 días), se genera un evento de tipo&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;text-wrap: nowrap;&quot;&gt;SecretNearExpiry&amp;nbsp;&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;text-wrap: nowrap;&quot;&gt;el cual es enviado al&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255); text-align: center; text-wrap: nowrap;&quot;&gt;Event Grid System Topic&lt;/span&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;" parent="kExKvFFj_C3QVHxMIAXy-1" vertex="1">
          <mxGeometry x="67" y="574" width="490" height="30" as="geometry" />
        </mxCell>
        <mxCell id="kExKvFFj_C3QVHxMIAXy-39" value="&lt;span style=&quot;text-wrap: nowrap;&quot;&gt;La función recibe el evento, rota la otra llave del storage account y la almacena en el secreto&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;text-wrap: nowrap;&quot;&gt;del key vault.&lt;/span&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;" parent="kExKvFFj_C3QVHxMIAXy-1" vertex="1">
          <mxGeometry x="67" y="659" width="490" height="30" as="geometry" />
        </mxCell>
        <mxCell id="kExKvFFj_C3QVHxMIAXy-40" value="&lt;div&gt;75 días para rotar la llave&lt;/div&gt;&lt;div&gt;(75-30)*2 = 90 días duración llaves&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;*key1 -&amp;gt; 0 días&lt;div&gt;key2 -&amp;gt; 0&lt;span style=&quot;background-color: initial;&quot;&gt;&amp;nbsp;días&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;rotar llave&lt;/div&gt;&lt;div&gt;key1 -&amp;gt; 45 días&lt;div&gt;*key2 -&amp;gt; 45&lt;span style=&quot;background-color: initial;&quot;&gt;&amp;nbsp;días -&amp;gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;0 días&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;rotar llave&lt;/div&gt;&lt;div&gt;*key1 -&amp;gt; 90 días -&amp;gt; 0 días&lt;div&gt;key2 -&amp;gt; 45 días&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="kExKvFFj_C3QVHxMIAXy-1" vertex="1">
          <mxGeometry x="615" y="559" width="210" height="200" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
