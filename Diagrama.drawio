          <mxGeometry x="300" y="226" width="20" height="20" as="geometry" />
        </mxCell>
        <mxCell id="2UWE28Y7-cGrshaWVusI-38" value="4" style="whiteSpace=wrap;html=1;fillColor=#1ba1e2;fontColor=#ffffff;strokeColor=#006EAF;glass=0;rounded=1;" parent="1" vertex="1">
          <mxGeometry x="960" y="378" width="20" height="20" as="geometry" />
        </mxCell>
        <mxCell id="2UWE28Y7-cGrshaWVusI-33" value="2" style="whiteSpace=wrap;html=1;fillColor=#1ba1e2;fontColor=#ffffff;strokeColor=#006EAF;glass=0;rounded=1;" parent="1" vertex="1">
          <mxGeometry x="37" y="625" width="20" height="20" as="geometry" />
        </mxCell>
        <mxCell id="2UWE28Y7-cGrshaWVusI-42" value="4" style="whiteSpace=wrap;html=1;fillColor=#1ba1e2;fontColor=#ffffff;strokeColor=#006EAF;glass=0;rounded=1;" parent="1" vertex="1">
          <mxGeometry x="37" y="710" width="20" height="20" as="geometry" />
        </mxCell>
        <mxCell id="2UWE28Y7-cGrshaWVusI-39" value="&lt;span style=&quot;text-wrap: nowrap;&quot;&gt;Inicialmente se almacena en un secreto del key vault la llave primaria de acceso del&amp;nbsp;&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;text-wrap: nowrap;&quot;&gt;storage account con una fecha de expiración de 75 días. Cada llave rota cada 90 días&lt;/span&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;" parent="1" vertex="1">
          <mxGeometry x="67" y="580" width="490" height="30" as="geometry" />
        </mxCell>
        <mxCell id="2UWE28Y7-cGrshaWVusI-43" value="&lt;span style=&quot;text-align: center; text-wrap: nowrap; background-color: rgb(255, 255, 255);&quot;&gt;El EventGrid System Topic&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;text-align: center; text-wrap: nowrap; background-color: initial;&quot;&gt;Event Subscription enruta el evento hacia una función que&amp;nbsp;&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;text-align: center; text-wrap: nowrap; background-color: initial;&quot;&gt;se encarga de realizar el proceso de rotación de llaves de acceso&lt;/span&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;" parent="1" vertex="1">
          <mxGeometry x="67" y="665" width="490" height="30" as="geometry" />
        </mxCell>
        <mxCell id="2UWE28Y7-cGrshaWVusI-40" value="&lt;span style=&quot;text-wrap: nowrap;&quot;&gt;Cuando el secreto esté cerca a expirar (30 días), se genera un evento de tipo&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;text-wrap: nowrap;&quot;&gt;SecretNearExpiry&amp;nbsp;&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;text-wrap: nowrap;&quot;&gt;el cual es enviado al&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255); text-align: center; text-wrap: nowrap;&quot;&gt;Event Grid System Topic&lt;/span&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;" parent="1" vertex="1">
          <mxGeometry x="67" y="620" width="490" height="30" as="geometry" />
        </mxCell>
        <mxCell id="2UWE28Y7-cGrshaWVusI-44" value="&lt;span style=&quot;text-wrap: nowrap;&quot;&gt;La función recibe el evento, rota la otra llave del storage account y la almacena en el secreto&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;text-wrap: nowrap;&quot;&gt;del key vault.&lt;/span&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;" parent="1" vertex="1">
          <mxGeometry x="67" y="705" width="490" height="30" as="geometry" />
        </mxCell>
        <mxCell id="YnGXoeyHL32SW1i-beLw-1" value="&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="630" y="585" width="20" height="30" as="geometry" />
        </mxCell>
        <mxCell id="9kTTmOfmLpjeDXTdC3WJ-1" value="&lt;div style=&quot;&quot;&gt;Se puede agregar un proceso de notificación cuando la llave sea rotada en el secreto del Key Vault&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;sketch=1;curveFitting=1;jiggle=2;dashed=1;align=center;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="787" y="590" width="200" height="80" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="Rotación de secreto regsitro de aplicación - Flujo de datos" id="Yh0slR7bpzYL-MywRABb">
    <mxGraphModel dx="1434" dy="844" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="82BO3MnDSIzr6zYUIbQJ-0" />
        <mxCell id="82BO3MnDSIzr6zYUIbQJ-1" parent="82BO3MnDSIzr6zYUIbQJ-0" />
        <mxCell id="82BO3MnDSIzr6zYUIbQJ-2" value="&lt;div style=&quot;&quot;&gt;Datos iniciales&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;ul&gt;&lt;li&gt;Nombre de secreto: app-reg-secret&lt;/li&gt;&lt;li&gt;tags:&amp;nbsp;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;CredentialId: password&lt;/li&gt;&lt;li&gt;ProviderAddress: Application Client ID&lt;/li&gt;&lt;li&gt;ValidityPeriodDays: 75&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;Application registration&lt;/li&gt;&lt;ul&gt;&lt;li&gt;client secret: password, expiración día 0 +75&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;/div&gt;&lt;div&gt;Acciones:&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;Creación inicial del secreto en el Key Vault&lt;/li&gt;&lt;/ul&gt;&lt;div&gt;Datos finales:&lt;br&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;Nombre de secreto: app-reg-secret&lt;/li&gt;&lt;li&gt;tags:&amp;nbsp;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;CredentialId: password&lt;/li&gt;&lt;li&gt;ProviderAddress: Application Client ID&lt;/li&gt;&lt;li&gt;ValidityPeriodDays: 75&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;Application registration&lt;/li&gt;&lt;ul&gt;&lt;li&gt;client secret: password, expiración día 0 +75&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;sketch=1;curveFitting=1;jiggle=2;dashed=1;align=left;" parent="82BO3MnDSIzr6zYUIbQJ-1" vertex="1">
          <mxGeometry x="40" y="50" width="250" height="530" as="geometry" />
        </mxCell>
        <mxCell id="82BO3MnDSIzr6zYUIbQJ-3" value="&lt;div style=&quot;&quot;&gt;Datos iniciales&lt;/div&gt;&lt;ul&gt;&lt;li&gt;Nombre de secreto: app-reg-secret&lt;/li&gt;&lt;li&gt;tags:&amp;nbsp;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;CredentialId: password&lt;/li&gt;&lt;li&gt;ProviderAddress: Application Client ID&lt;/li&gt;&lt;li&gt;ValidityPeriodDays: 75&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;Application registration&lt;/li&gt;&lt;ul&gt;&lt;li&gt;client secret: password, expiración día 45 +30&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;div&gt;Acciones:&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;30 días antes del vencimiento del secreto, es decir a los 45 días de creado el secreto, se genera el evento de&amp;nbsp;&lt;span style=&quot;text-align: center;&quot;&gt;SecretNearExpiry&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;text-align: center;&quot;&gt;Se ejecuta el proceso de rotación de llaves&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;div&gt;Datos finales:&lt;br&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;Nombre de secreto: app-reg-secret&lt;/li&gt;&lt;li&gt;tags:&amp;nbsp;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;CredentialId: password1&lt;/li&gt;&lt;li&gt;ProviderAddress: Application Client ID&lt;/li&gt;&lt;li&gt;ValidityPeriodDays: 75&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;Application registration&lt;/li&gt;&lt;ul&gt;&lt;li&gt;client secret: password, expiración día 45 +30&lt;/li&gt;&lt;li&gt;client secret: password1, expiración día 0 +75&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;sketch=1;curveFitting=1;jiggle=2;dashed=1;align=left;" parent="82BO3MnDSIzr6zYUIbQJ-1" vertex="1">
          <mxGeometry x="334.5" y="50" width="250" height="530" as="geometry" />
        </mxCell>
        <mxCell id="82BO3MnDSIzr6zYUIbQJ-4" value="&lt;div style=&quot;&quot;&gt;Datos iniciales&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;ul&gt;&lt;li&gt;Nombre de secreto: app-reg-secret&lt;/li&gt;&lt;li&gt;tags:&amp;nbsp;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;CredentialId: password1&lt;/li&gt;&lt;li&gt;ProviderAddress: Application Client ID&lt;/li&gt;&lt;li&gt;ValidityPeriodDays: 75&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;Application registration&lt;/li&gt;&lt;ul&gt;&lt;li&gt;client secret: password, expiración día 90 (30 expirado)&lt;/li&gt;&lt;li&gt;client secret: password1, expiración día 45 +30&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;/div&gt;&lt;div&gt;Acciones:&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;Nuevamente a los 30 días antes del vencimiento del secreto, es decir a los 45 días de la última rotación, se genera el evento de&amp;nbsp;&lt;span style=&quot;text-align: center;&quot;&gt;SecretNearExpiry&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;text-align: center;&quot;&gt;Se ejecuta el proceso de rotación de llaves&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;div&gt;Datos finales:&lt;br&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;Nombre de secreto: app-reg-secret&lt;/li&gt;&lt;li&gt;tags:&amp;nbsp;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;CredentialId: password2&lt;/li&gt;&lt;li&gt;ProviderAddress: Application Client ID&lt;/li&gt;&lt;li&gt;ValidityPeriodDays: 75&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;Application registration&lt;/li&gt;&lt;ul&gt;&lt;li&gt;client secret: password, (expirado)&lt;/li&gt;&lt;li&gt;client secret: password1, expiración día 45 +30&lt;/li&gt;&lt;li&gt;client secret: password2, expiración día 0 +75&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;sketch=1;curveFitting=1;jiggle=2;dashed=1;align=left;" parent="82BO3MnDSIzr6zYUIbQJ-1" vertex="1">
